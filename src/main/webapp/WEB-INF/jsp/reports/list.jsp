<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Reports</h1><%@ include file="../fragments/flash.jspf" %><section class="command-bar" aria-label="Report types"><c:forEach items="${['Prescription','Dispensing','Inventory','UserAccess']}" var="type"><a class="card btn btn-secondary" href="${pageContext.request.contextPath}/admin/reports/new?type=${type}">${type} report</a></c:forEach></section><c:choose><c:when test="${empty reports}"><section class="card"><div class="card-body"><h2 class="section-title">No saved reports</h2><p>Generate a report to persist an immutable snapshot.</p></div></section></c:when><c:otherwise><div class="table-wrap"><table class="data-table" aria-label="Saved reports"><thead><tr><th scope="col">Title</th><th scope="col">Type</th><th scope="col">Rows</th><th scope="col">Generated by</th><th scope="col">Generated at</th><th scope="col">Actions</th></tr></thead><tbody><c:forEach items="${reports}" var="report"><tr><td>${report.title}</td><td>${report.reportType}</td><td>${report.rowCount}</td><td>${report.generatedBy}</td><td>${report.generatedAt}</td><td><a class="btn btn-link" href="${pageContext.request.contextPath}/admin/reports/${report.reportId}">Open</a><a class="btn btn-link" href="${pageContext.request.contextPath}/admin/reports/${report.reportId}/export">Export PDF</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main></div></div></body></html>

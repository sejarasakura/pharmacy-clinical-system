<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Report criteria</h1><form class="card form-grid" method="post" action="${pageContext.request.contextPath}/admin/reports/generate" data-submit-lock><%@ include file="../fragments/csrf.jspf" %><div class="field"><label for="reportType">Report type</label><select id="reportType" name="reportType"><c:forEach items="${['Prescription','Dispensing','Inventory','UserAccess']}" var="type"><option value="${type}" ${reportType eq type ? 'selected' : ''}>${type}</option></c:forEach></select></div><div class="field"><label for="startDate">Start date</label><input id="startDate" name="startDate" type="date" value="${startDate}" class="${not empty dateError ? 'input-error' : ''}" aria-describedby="${not empty dateError ? 'date-error' : ''}"></div><div class="field"><label for="endDate">End date</label><input id="endDate" name="endDate" type="date" value="${endDate}" class="${not empty dateError ? 'input-error' : ''}" aria-describedby="${not empty dateError ? 'date-error' : ''}"><c:if test="${not empty dateError}"><div id="date-error" class="field-error">${dateError}</div></c:if></div><section class="card"><div class="card-body"><h2 class="section-title">Criteria summary</h2><p>Generate an immutable ${reportType} snapshot for the selected date range.</p></div></section><button class="btn btn-primary" type="submit">Generate</button></form></main></div></div></body></html>

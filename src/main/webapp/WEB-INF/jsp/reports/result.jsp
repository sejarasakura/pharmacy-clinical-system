<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><div class="page-header"><div><h1 class="page-title">${report.title}</h1><p class="page-subtitle">Generated ${report.generatedAt} · ${report.rowCount} rows</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/reports/${report.reportId}/export">Export PDF</a></div><%@ include file="../fragments/flash.jspf" %><section class="card"><div class="card-body"><h2 class="section-title">Criteria</h2><p>${report.criteria}</p></div></section><c:choose><c:when test="${report.rowCount eq 0}"><section class="card"><div class="card-body"><h2 class="section-title">No matching records</h2><p>The empty result remains a persisted report snapshot and can still be exported.</p></div></section></c:when><c:otherwise><div class="table-wrap"><table class="data-table" aria-label="Report snapshot"><thead><tr><th scope="col">Snapshot row</th></tr></thead><tbody><c:forEach items="${report.data}" var="row"><tr><td>${row}</td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main></div></div></body></html>

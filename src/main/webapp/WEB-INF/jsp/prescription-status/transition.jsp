<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Confirm status change</h1><c:if test="${stale}"><div class="alert alert-danger" role="alert">The prescription changed. <a href="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/status">Reload latest</a></div></c:if><section class="card"><div class="card-body"><p>Current: ${prescription.status}</p><p>Target: ${target}</p><form class="form-grid" method="post" action="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/status" data-submit-lock><%@ include file="../fragments/csrf.jspf" %><input type="hidden" name="target" value="${target}"><input type="hidden" name="expectedVersion" value="${expectedVersion}"><div class="field"><label for="reason">Reason</label><textarea id="reason" name="reason" class="${not empty reasonError ? 'input-error' : ''}" aria-describedby="${not empty reasonError ? 'reason-error' : ''}"></textarea><c:if test="${not empty reasonError}"><div id="reason-error" class="field-error">${reasonError}</div></c:if></div><div class="sticky-actions"><button class="btn btn-primary" type="submit">Confirm transition</button><a class="btn btn-secondary" href="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/status">Cancel</a></div></form></div></section></main></div></div></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Clinical status management</h1><section class="card"><div class="card-body"><h2 class="section-title">Prescription ${prescription.prescriptionId}</h2><c:set var="statusKind" value="clinical"/><c:set var="statusValue" value="${prescription.status}"/><%@ include file="../fragments/status-badge.jspf" %><p>Issued: ${prescription.issuedAt}</p><c:choose><c:when test="${empty allowedTransitions}"><div class="alert alert-warning" role="status">No transitions are permitted from this status.</div></c:when><c:otherwise><div class="command-bar"><c:forEach items="${allowedTransitions}" var="target"><a class="btn btn-primary" href="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/status/change?target=${target}">${target}</a></c:forEach></div></c:otherwise></c:choose></div></section></main></div></div></body></html>

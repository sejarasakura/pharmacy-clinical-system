<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Receive or adjust stock</h1><c:if test="${not empty stockError}"><div class="alert alert-danger" role="alert">${stockError}</div></c:if><section class="card"><div class="card-section"><h2 class="section-title">Receive a new batch</h2><form class="form-grid" method="post" action="${pageContext.request.contextPath}/pharmacy/inventory/${medicine.medicineId}/receive" data-submit-lock><%@ include file="../fragments/csrf.jspf" %><div class="field"><label for="batchNumber">Batch number</label><input id="batchNumber" name="batchNumber"></div><div class="field"><label for="expiryDate">Expiry date</label><input id="expiryDate" name="expiryDate" type="date"></div><div class="field"><label for="quantity">Quantity received</label><input id="quantity" name="quantity" type="number" min="1"></div><button class="btn btn-primary" type="submit">Receive Stock</button></form></div></section><section class="card"><div class="card-section"><h2 class="section-title">Manual adjustment</h2><c:choose><c:when test="${empty batches}"><p class="empty-state">Receive a batch before making a manual adjustment.</p></c:when><c:otherwise><c:forEach items="${batches}" var="batch"><form class="form-grid" method="post" action="${pageContext.request.contextPath}/pharmacy/inventory/${batch.inventoryId}/adjust" data-submit-lock><%@ include file="../fragments/csrf.jspf" %><h3 class="section-title">Batch ${batch.batchNumber} — current balance ${batch.quantityOnHand}</h3><input id="currentBalance-${batch.inventoryId}" type="hidden" value="${batch.quantityOnHand}"><input type="hidden" name="expectedVersion" value="${batch.version}"><div class="field"><label for="quantityDelta-${batch.inventoryId}">Quantity change</label><input id="quantityDelta-${batch.inventoryId}" name="quantityDelta" type="number"></div><div class="field"><label for="reason-${batch.inventoryId}">Adjustment reason</label><textarea id="reason-${batch.inventoryId}" name="reason" class="${not empty reasonError and failedInventoryId eq batch.inventoryId ? 'input-error' : ''}" aria-describedby="${not empty reasonError and failedInventoryId eq batch.inventoryId ? 'reason-error-' : ''}${batch.inventoryId}"></textarea><c:if test="${not empty reasonError and failedInventoryId eq batch.inventoryId}"><div id="reason-error-${batch.inventoryId}" class="field-error">${reasonError}</div></c:if></div><p data-projected-balance="currentBalance-${batch.inventoryId}:quantityDelta-${batch.inventoryId}:projectedBalance-${batch.inventoryId}">Projected balance: <strong id="projectedBalance-${batch.inventoryId}">—</strong></p><button class="btn btn-danger" type="submit">Adjust Batch</button></form></c:forEach></c:otherwise></c:choose></div></section></main></div></div></body></html>

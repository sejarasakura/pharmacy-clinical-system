<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><div class="page-header"><div><h1 class="page-title">${medicine.medicineName}</h1><p class="page-subtitle">${medicine.medicineCode} · ${medicine.genericName}</p></div><div class="command-bar"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/pharmacy/inventory/${medicine.medicineId}/edit">Edit</a><a class="btn btn-primary" href="${pageContext.request.contextPath}/pharmacy/inventory/${medicine.medicineId}/stock">Receive / Adjust Stock</a></div></div><%@ include file="../fragments/flash.jspf" %><section class="card"><div class="card-body"><h2 class="section-title">Dispensable stock</h2><p>${dispensableStock} ${medicine.unit}</p></div></section><div class="table-wrap"><table class="data-table" aria-label="Inventory batches"><thead><tr><th scope="col">Batch</th><th scope="col">Expiry</th><th scope="col">On hand</th><th scope="col">Eligibility</th></tr></thead><tbody><c:forEach items="${batches}" var="batch"><tr><td>${batch.batchNumber}</td><td>${batch.expiryDate}</td><td>${batch.quantityOnHand}</td><td><c:set var="statusKind" value="inventory"/><c:set var="statusValue" value="${batch.expired ? 'EXPIRED' : batch.lowStock ? 'LOW' : 'NORMAL'}"/><%@ include file="../fragments/status-badge.jspf" %></td></tr></c:forEach></tbody></table></div><section class="card"><div class="card-body"><h2 class="section-title">Movement history</h2><p class="muted">No stock movements are recorded for this medicine yet.</p></div></section></main></div></div></body></html>

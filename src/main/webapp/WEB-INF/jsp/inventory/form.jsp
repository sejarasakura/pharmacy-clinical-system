<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">${empty medicine ? 'Add medicine' : 'Edit medicine'}</h1><c:if test="${not empty duplicateError}"><div class="alert alert-danger" role="alert">${duplicateError}</div></c:if><c:if test="${stale}"><div class="alert alert-warning" role="alert">Record has changed. <a href="${pageContext.request.contextPath}/pharmacy/inventory/${medicine.medicineId}/edit">Reload latest</a></div></c:if><c:choose><c:when test="${empty medicine}"><c:url var="medicineAction" value="/pharmacy/inventory/medicine"/></c:when><c:otherwise><c:url var="medicineAction" value="/pharmacy/inventory/${medicine.medicineId}/medicine"/></c:otherwise></c:choose><form class="card form-grid" method="post" action="${medicineAction}" data-submit-lock><%@ include file="../fragments/csrf.jspf" %><c:if test="${not empty medicine}"><input type="hidden" name="expectedVersion" value="${expectedVersion}"></c:if><div class="field"><label for="medicineCode">Medicine code</label><input id="medicineCode" name="medicineCode" value="${empty medicine ? medicineCode : medicine.medicineCode}" class="${not empty duplicateError ? 'input-error' : ''}" aria-describedby="${not empty duplicateError ? 'medicineCode-error' : ''}"><c:if test="${not empty duplicateError}"><div id="medicineCode-error" class="field-error">${duplicateError}</div></c:if></div><div class="field"><label for="medicineName">Medicine name</label><input id="medicineName" name="medicineName" value="${empty medicine ? medicineName : medicine.medicineName}"></div><div class="field"><label for="genericName">Generic name</label><input id="genericName" name="genericName" value="${medicine.genericName}"></div><div class="field"><label for="dosageForm">Dosage form</label><input id="dosageForm" name="dosageForm" value="${medicine.dosageForm}"></div><div class="field"><label for="strength">Strength</label><input id="strength" name="strength" value="${medicine.strength}"></div><div class="field"><label for="unit">Unit</label><input id="unit" name="unit" value="${medicine.unit}"></div><div class="field"><label for="description">Description</label><textarea id="description" name="description">${medicine.description}</textarea></div><div class="sticky-actions"><button class="btn btn-primary" type="submit">Save</button><a class="btn btn-secondary" href="${pageContext.request.contextPath}/pharmacy/inventory">Cancel</a></div></form></main></div></div></body></html>

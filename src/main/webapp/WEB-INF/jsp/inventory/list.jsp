<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><div class="page-header"><div><h1 class="page-title">Medicine inventory</h1><p class="page-subtitle">Dispensable quantities exclude expired batches.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/pharmacy/inventory/new">Add Medicine</a></div><%@ include file="../fragments/flash.jspf" %><form id="inventory-filters" class="toolbar" method="get" action="${pageContext.request.contextPath}/pharmacy/inventory"><div class="field"><label for="search">Search medicines</label><input id="search" name="search" value="${search}"></div><button class="btn btn-secondary" type="submit">Refresh</button><button class="btn btn-secondary" type="button" data-filter-clear="inventory-filters">Clear Filters</button></form><c:choose><c:when test="${empty medicines}"><section class="card"><div class="card-body"><h2 class="section-title">${filtersActive ? 'No matching medicines' : 'No medicines yet'}</h2><c:choose><c:when test="${filtersActive}"><button class="btn btn-secondary" type="button" data-filter-clear="inventory-filters">Clear Filters</button></c:when><c:otherwise><a class="btn btn-primary" href="${pageContext.request.contextPath}/pharmacy/inventory/new">Add Medicine</a></c:otherwise></c:choose></div></section></c:when><c:otherwise><div class="table-wrap"><table class="data-table" aria-label="Medicine inventory"><thead><tr><th scope="col">Medicine</th><th scope="col">Formulation</th><th scope="col">Dispensable stock</th><th scope="col">Stock status</th><th scope="col">Action</th></tr></thead><tbody><c:forEach items="${medicines}" var="medicine"><tr><td>${medicine.medicineCode} — ${medicine.medicineName}</td><td>${medicine.dosageForm} ${medicine.strength}</td><td>${stock[medicine.medicineId]}</td><td><c:set var="statusKind" value="inventory"/><c:set var="statusValue" value="${stockStatus[medicine.medicineId]}"/><%@ include file="../fragments/status-badge.jspf" %></td><td><a class="btn btn-link" href="${pageContext.request.contextPath}/pharmacy/inventory/${medicine.medicineId}">Open</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main></div></div></body></html>

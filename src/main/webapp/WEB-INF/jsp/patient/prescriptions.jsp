<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">My prescriptions</h1><p class="page-subtitle">Read-only clinical and pharmacy status.</p><c:choose><c:when test="${empty prescriptions}"><section class="card"><div class="card-body"><h2 class="section-title">No visible prescriptions</h2><p>Draft prescriptions do not appear here.</p></div></section></c:when><c:otherwise><div class="table-wrap"><table class="data-table" aria-label="My prescriptions"><thead><tr><th scope="col">Prescription</th><th scope="col">Prescribed</th><th scope="col">Clinical status</th><th scope="col">Fulfilment status</th><th scope="col">Action</th></tr></thead><tbody><c:forEach items="${prescriptions}" var="rx"><tr><td>${rx.prescriptionId}</td><td>${rx.prescribedAt}</td><td><c:set var="statusKind" value="clinical"/><c:set var="statusValue" value="${rx.clinicalStatus}"/><%@ include file="../fragments/status-badge.jspf" %></td><td><c:set var="statusKind" value="fulfilment"/><c:set var="statusValue" value="${rx.fulfilmentStatus}"/><%@ include file="../fragments/status-badge.jspf" %></td><td><a class="btn btn-link" href="${pageContext.request.contextPath}/patient/prescriptions/${rx.prescriptionId}">View</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main></div></div></body></html>

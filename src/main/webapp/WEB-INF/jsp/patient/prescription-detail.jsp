<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Prescription ${prescription.prescriptionId}</h1><c:if test="${prescription.clinicalStatus eq 'EXPIRED' or prescription.clinicalStatus eq 'CANCELLED'}"><div class="alert alert-warning" role="status">This prescription is no longer active.</div></c:if><section class="card"><div class="card-body"><h2 class="section-title">Status timeline</h2><p>Clinical: <c:set var="statusKind" value="clinical"/><c:set var="statusValue" value="${prescription.clinicalStatus}"/><%@ include file="../fragments/status-badge.jspf" %></p><p>Fulfilment: <c:set var="statusKind" value="fulfilment"/><c:set var="statusValue" value="${prescription.fulfilmentStatus}"/><%@ include file="../fragments/status-badge.jspf" %></p></div></section><div class="table-wrap"><table class="data-table" aria-label="Medication instructions"><thead><tr><th scope="col">Medicine</th><th scope="col">Dosage</th><th scope="col">Frequency</th><th scope="col">Instructions</th><th scope="col">Quantity</th></tr></thead><tbody><c:forEach items="${prescriptionRecord.items}" var="item"><tr><td>${item.medicineName}</td><td>${item.dosage}</td><td>${item.frequency}</td><td>${item.instructions}</td><td>${item.quantity}</td></tr></c:forEach></tbody></table></div></main></div></div></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Cancel prescription</h1><section class="card"><div class="card-body"><h2 class="section-title">Prescription ${prescription.prescriptionId}</h2><p>Patient ${prescription.patientId}; current status ${prescription.status}.</p><form class="form-grid" method="post" action="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/cancel" data-submit-lock><%@ include file="../fragments/csrf.jspf" %><div class="field"><label for="reason">Cancellation reason</label><textarea id="reason" name="reason" class="${not empty reasonError ? 'input-error' : ''}" aria-describedby="${not empty reasonError ? 'reason-error' : ''}"></textarea><c:if test="${not empty reasonError}"><div id="reason-error" class="field-error">${reasonError}</div></c:if></div><div class="sticky-actions"><button class="btn btn-danger" type="submit">Confirm cancellation</button><a class="btn btn-secondary" href="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}">Cancel</a></div></form></div></section></main></div></div></body></html>

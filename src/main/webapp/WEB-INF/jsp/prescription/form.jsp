<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">${empty prescription ? 'Create prescription' : 'Edit prescription'}</h1>
<c:if test="${not empty formError}"><div class="alert alert-danger" role="alert">${formError}</div></c:if><c:if test="${stale}"><div class="alert alert-warning" role="alert">Record has changed. <a href="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/edit">Reload latest</a></div></c:if>
<form class="card form-grid" method="post" action="${pageContext.request.contextPath}/doctor/prescriptions${empty prescription ? '' : '/'.concat(prescription.prescriptionId)}" data-submit-lock><%@ include file="../fragments/csrf.jspf" %><c:if test="${not empty prescription}"><input type="hidden" name="expectedVersion" value="${expectedVersion}"></c:if><div class="field"><label for="patientId">Patient ID</label><input id="patientId" name="patientId" type="number" min="1" value="${prescription.patientId}" ${not empty prescription ? 'readonly' : ''}></div><div class="field"><label for="clinicalNotes">Clinical notes</label><textarea id="clinicalNotes" name="clinicalNotes">${prescription.clinicalNotes}</textarea></div>
<c:if test="${empty prescription}"><fieldset><legend>Medication items</legend><c:choose><c:when test="${empty items}"><div class="form-grid"><div class="field"><label for="medicineId-0">Medicine ID</label><input id="medicineId-0" name="medicineId" type="number" min="1"></div><div class="field"><label for="medicineName-0">Medicine name</label><input id="medicineName-0" name="medicineName"></div><div class="field"><label for="dosage-0">Dosage</label><input id="dosage-0" name="dosage"></div><div class="field"><label for="frequency-0">Frequency</label><input id="frequency-0" name="frequency"></div><div class="field"><label for="instructions-0">Instructions</label><input id="instructions-0" name="instructions"></div><div class="field"><label for="quantity-0">Quantity</label><input id="quantity-0" name="quantity" type="number" min="1"></div></div></c:when><c:otherwise><c:forEach items="${items}" var="item" varStatus="row"><div class="form-grid"><div class="field"><label for="medicineId-${row.index}">Medicine ID</label><input id="medicineId-${row.index}" name="medicineId" type="number" value="${item.medicineId}"></div><div class="field"><label for="medicineName-${row.index}">Medicine name</label><input id="medicineName-${row.index}" name="medicineName" value="${item.medicineName}"></div><div class="field"><label for="dosage-${row.index}">Dosage</label><input id="dosage-${row.index}" name="dosage" value="${item.dosage}"></div><div class="field"><label for="frequency-${row.index}">Frequency</label><input id="frequency-${row.index}" name="frequency" value="${item.frequency}"></div><div class="field"><label for="instructions-${row.index}">Instructions</label><input id="instructions-${row.index}" name="instructions" value="${item.instructions}"></div><div class="field"><label for="quantity-${row.index}">Quantity</label><input id="quantity-${row.index}" name="quantity" type="number" value="${item.quantity}"></div></div></c:forEach></c:otherwise></c:choose><button class="btn btn-add" type="button">Add medication</button></fieldset></c:if>
<div class="sticky-actions"><button class="btn btn-primary" type="submit">Save</button><a class="btn btn-secondary" href="${pageContext.request.contextPath}/doctor/prescriptions">Cancel</a></div></form></main></div></div></body></html>

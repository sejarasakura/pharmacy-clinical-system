<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><div class="page-header"><div><h1 class="page-title">Prescription ${prescription.prescriptionId}</h1><p class="page-subtitle">Patient ${prescription.patientId}</p></div><div><c:set var="statusKind" value="clinical"/><c:set var="statusValue" value="${terminal and prescription.status ne 'CANCELLED' ? 'EXPIRED' : prescription.status}"/><%@ include file="../fragments/status-badge.jspf" %></div></div><%@ include file="../fragments/flash.jspf" %>
<c:if test="${terminal}"><div class="alert alert-warning" role="status">This prescription is cancelled or expired and cannot be changed.</div></c:if><section class="card"><div class="card-body"><h2 class="section-title">Clinical notes</h2><p>${prescription.clinicalNotes}</p></div></section><div class="table-wrap"><table class="data-table" aria-label="Medication items"><thead><tr><th scope="col">Medicine</th><th scope="col">Dosage</th><th scope="col">Frequency</th><th scope="col">Instructions</th><th scope="col">Quantity</th></tr></thead><tbody><c:forEach items="${items}" var="item"><tr><td>${item.medicineName}</td><td>${item.dosage}</td><td>${item.frequency}</td><td>${item.instructions}</td><td>${item.quantity}</td></tr></c:forEach></tbody></table></div>
<section class="card"><div class="card-body"><h2 class="section-title">Fulfilment</h2><p>Pharmacy fulfilment remains read-only in the clinical workspace.</p><c:if test="${not terminal}"><div class="command-bar"><a class="btn btn-primary" href="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/edit">Edit</a><a class="btn btn-secondary" href="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/status">Change Status</a><a class="btn btn-danger" href="${pageContext.request.contextPath}/doctor/prescriptions/${prescription.prescriptionId}/cancel">Cancel Prescription</a></div></c:if></div></section></main></div></div></body></html>

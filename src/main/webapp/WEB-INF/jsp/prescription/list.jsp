<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><div class="page-header"><div><h1 class="page-title">Prescription workspace</h1><p class="page-subtitle">Author and monitor clinical prescriptions.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/doctor/prescriptions/new">Create Prescription</a></div><%@ include file="../fragments/flash.jspf" %>
<form id="prescription-filters" class="toolbar" method="get" action="${pageContext.request.contextPath}/doctor/prescriptions"><div class="field"><label for="search">Search</label><input id="search" name="search" value="${search}"></div><div class="field"><label for="status">Clinical status</label><select id="status" name="status"><option value="">All statuses</option><option>DRAFT</option><option>ISSUED</option><option>ON_HOLD</option><option>CANCELLED</option><option>EXPIRED</option></select></div><button class="btn btn-secondary" type="submit">Refresh</button><button class="btn btn-secondary" type="button" data-filter-clear="prescription-filters">Clear Filters</button></form>
<c:choose><c:when test="${empty prescriptions}"><section class="card"><div class="card-body"><h2 class="section-title">${filtersActive ? 'No matching prescriptions' : 'No prescriptions yet'}</h2><p>${filtersActive ? 'Clear filters to see the complete workspace.' : 'Create the first prescription for a patient.'}</p><c:choose><c:when test="${filtersActive}"><button class="btn btn-secondary" type="button" data-filter-clear="prescription-filters">Clear Filters</button></c:when><c:otherwise><a class="btn btn-primary" href="${pageContext.request.contextPath}/doctor/prescriptions/new">Create Prescription</a></c:otherwise></c:choose></div></section></c:when><c:otherwise><div class="table-wrap"><table class="data-table" aria-label="Prescriptions"><thead><tr><th scope="col">Prescription</th><th scope="col">Patient</th><th scope="col">Created</th><th scope="col">Clinical status</th><th scope="col">Action</th></tr></thead><tbody><c:forEach items="${prescriptions}" var="rx"><tr><td>${rx.prescriptionId}</td><td>${rx.patientId}</td><td>${rx.createdAt}</td><td><c:set var="statusKind" value="clinical"/><c:set var="statusValue" value="${rx.terminalState and rx.status ne 'CANCELLED' ? 'EXPIRED' : rx.status}"/><%@ include file="../fragments/status-badge.jspf" %></td><td><a class="btn btn-link" href="${pageContext.request.contextPath}/doctor/prescriptions/${rx.prescriptionId}">Open</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main></div></div></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Verify and dispense</h1><ol class="stepper" aria-label="Dispensing steps"><li>Verify Patient</li><li>Verify Medication</li><li>Check Stock</li><li>Confirm Handover</li></ol><c:if test="${not sufficientStock}"><div class="alert alert-danger" role="alert">Insufficient Stock. The full prescribed quantity cannot be allocated.</div></c:if><section class="card"><div class="card-body"><h2 class="section-title">Transaction summary</h2><dl><dt>Dispense record</dt><dd>${record.dispenseId}</dd><dt>Prescription</dt><dd>${record.prescriptionId}</dd><dt>Patient</dt><dd>${record.patientId}</dd></dl><div class="table-wrap"><table class="data-table" aria-label="Required medicines"><thead><tr><th scope="col">Medicine ID</th><th scope="col">Prescribed quantity</th></tr></thead><tbody><c:forEach items="${record.requiredQuantities}" var="quantity"><tr><td>${quantity.key}</td><td>${quantity.value}</td></tr></c:forEach></tbody></table></div><form method="post" action="${pageContext.request.contextPath}/pharmacy/dispensing/${record.dispenseId}/confirm" data-submit-lock><%@ include file="../fragments/csrf.jspf" %><div class="sticky-actions"><button class="btn btn-primary" type="submit" ${not sufficientStock ? 'disabled' : ''}>Confirm Handover</button><a class="btn btn-secondary" href="${pageContext.request.contextPath}/pharmacy/dispensing">Cancel</a></div></form></div></section></main></div></div></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Dispensing queue</h1><%@ include file="../fragments/flash.jspf" %><div class="table-wrap"><table class="data-table" aria-label="Dispensing queue"><thead><tr><th scope="col">Prescription</th><th scope="col">Patient</th><th scope="col">Clinical eligibility</th><th scope="col">Fulfilment</th><th scope="col">Block reason</th><th scope="col">Action</th></tr></thead><tbody><c:forEach items="${prescriptions}" var="rx"><tr><td>${rx.prescriptionId}</td><td>${rx.patientId}</td><td><c:set var="statusKind" value="clinical"/><c:set var="statusValue" value="${rx.terminalState and rx.status ne 'CANCELLED' ? 'EXPIRED' : rx.status}"/><%@ include file="../fragments/status-badge.jspf" %></td><td><c:set var="statusKind" value="fulfilment"/><c:set var="statusValue" value="${empty fulfilmentByPrescription[rx.prescriptionId] ? 'PENDING' : fulfilmentByPrescription[rx.prescriptionId]}"/><%@ include file="../fragments/status-badge.jspf" %></td><td><c:if test="${not actionable[rx.prescriptionId]}"><span class="status status-danger">${blockReason[rx.prescriptionId]}</span></c:if></td><td><c:if test="${actionable[rx.prescriptionId]}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/pharmacy/dispensing/prescription/${rx.prescriptionId}">Dispense</a></c:if></td></tr></c:forEach></tbody></table></div></main></div></div></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Dispensing result</h1><c:choose><c:when test="${success}"><div class="alert alert-success" role="status">Medication dispensed successfully.</div><section class="card"><div class="card-body"><dl><dt>Dispense record</dt><dd>${record.dispenseId}</dd><dt>Patient</dt><dd>${record.patientId}</dd><dt>Timestamp</dt><dd>${record.dispensedAt}</dd><dt>Quantities</dt><dd>${record.dispensedQuantities}</dd></dl><a class="btn btn-primary" href="${pageContext.request.contextPath}/pharmacy/dispensing">Back to Queue</a></div></section></c:when><c:otherwise><div class="alert alert-danger" role="alert">Dispensing was not committed: ${record.failureReason}</div><a class="btn btn-primary" href="${pageContext.request.contextPath}/pharmacy/dispensing/${record.dispenseId}/verify">Back to Verification</a></c:otherwise></c:choose></main></div></div></body></html>

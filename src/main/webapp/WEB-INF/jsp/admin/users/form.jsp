<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../../fragments/head.jspf" %></head><body><%@ include file="../../fragments/shell.jspf" %><h1 class="page-title">${empty account ? 'Add account' : 'Edit account'}</h1>
<c:if test="${not empty duplicateError}"><div class="alert alert-danger" role="alert">${duplicateError}</div></c:if><c:if test="${stale}"><div class="alert alert-warning" role="alert">Record has changed. <a href="${pageContext.request.contextPath}/admin/users/${account.userId}/edit">Reload latest</a></div></c:if>
<form class="card form-grid" method="post" action="${pageContext.request.contextPath}/admin/users${empty account ? '' : '/'.concat(account.userId)}" data-submit-lock><%@ include file="../../fragments/csrf.jspf" %><c:if test="${not empty account}"><input type="hidden" name="expectedVersion" value="${expectedVersion}"></c:if>
<div class="field"><label for="username">Username</label><input id="username" name="username" value="${form.usernameInput}" ${not empty account ? 'readonly' : ''} class="${not empty duplicateError ? 'input-error' : ''}" aria-describedby="${not empty duplicateError ? 'username-error' : ''}"><c:if test="${not empty duplicateError}"><div id="username-error" class="field-error">${duplicateError}</div></c:if></div>
<div class="field"><label for="email">Email</label><input id="email" name="email" type="email" value="${form.emailInput}"></div><c:if test="${empty account}"><div class="field"><label for="role">Operational role</label><select id="role" name="role"><option value="">Select role</option><c:forEach items="${roles}" var="role"><option value="${role.roleName}" ${selectedRole eq role.roleName ? 'selected' : ''}>${role.roleName}</option></c:forEach></select></div></c:if>
<c:if test="${empty account}"><div class="field"><label for="initialPassword">Initial password</label><input id="initialPassword" name="initialPassword" type="password" autocomplete="new-password" minlength="8" required class="${not empty initialPasswordError ? 'input-error' : ''}" aria-describedby="initialPassword-hint${not empty initialPasswordError ? ' initialPassword-error' : ''}"><span id="initialPassword-hint" class="muted">At least eight characters. Give this securely to the new member.</span><c:if test="${not empty initialPasswordError}"><div id="initialPassword-error" class="field-error">${initialPasswordError}</div></c:if></div><div class="field"><label for="confirmPassword">Confirm initial password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required class="${not empty confirmPasswordError ? 'input-error' : ''}" aria-describedby="${not empty confirmPasswordError ? 'confirmPassword-error' : ''}"><c:if test="${not empty confirmPasswordError}"><div id="confirmPassword-error" class="field-error">${confirmPasswordError}</div></c:if></div></c:if>
<c:if test="${selectedRole eq 'Patient'}"><section class="card"><h2 class="section-title">Link patient business record</h2><div class="field"><label for="patientIdentifier">Patient record</label><select id="patientIdentifier" name="patientIdentifier"><c:forEach items="${patientRecords}" var="patient"><option value="${patient.patientIdentifier}">${patient.patientIdentifier} — ${patient.fullName}</option></c:forEach></select></div></section></c:if>
<div class="sticky-actions"><button class="btn btn-primary" type="submit">Save</button><a class="btn btn-secondary" href="${pageContext.request.contextPath}/admin/users">Cancel</a></div></form></main></div></div></body></html>

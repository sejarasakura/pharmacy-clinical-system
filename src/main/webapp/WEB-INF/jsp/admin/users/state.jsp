<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../../fragments/head.jspf" %></head><body><%@ include file="../../fragments/shell.jspf" %><h1 class="page-title">Confirm account state</h1>
<section class="card"><div class="card-body"><h2 class="section-title">${account.username}</h2><p>Current status: ${account.status}</p><p>Requested action: ${action}</p>
<form class="form-grid" method="post" action="${pageContext.request.contextPath}/admin/users/${account.userId}/${action}" data-submit-lock><%@ include file="../../fragments/csrf.jspf" %><c:if test="${action eq 'disable'}"><div class="field"><label for="reason">Reason</label><textarea id="reason" name="reason" required></textarea></div></c:if><div class="sticky-actions"><button class="btn ${action eq 'disable' ? 'btn-danger' : 'btn-primary'}" type="submit">Confirm</button><a class="btn btn-secondary" href="${pageContext.request.contextPath}/admin/users/${account.userId}/access">Cancel</a></div></form></div></section></main></div></div></body></html>

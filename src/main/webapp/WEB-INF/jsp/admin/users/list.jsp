<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../../fragments/head.jspf" %></head><body><%@ include file="../../fragments/shell.jspf" %>
<div class="page-header"><div><h1 class="page-title">User accounts</h1><p class="page-subtitle">Administer operational access and account state.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/users/new">Add Account</a></div><%@ include file="../../fragments/flash.jspf" %>
<form id="user-filters" class="toolbar" method="get" action="${pageContext.request.contextPath}/admin/users"><div class="field"><label for="search">Search</label><input id="search" name="search" value="${search}"></div><div class="field"><label for="role">Role</label><select id="role" name="role"><option value="">All roles</option><option ${roleFilter eq 'Patient' ? 'selected' : ''}>Patient</option><option ${roleFilter eq 'Doctor' ? 'selected' : ''}>Doctor</option><option ${roleFilter eq 'Pharmacist' ? 'selected' : ''}>Pharmacist</option><option ${roleFilter eq 'Administrator' ? 'selected' : ''}>Administrator</option></select></div><div class="field"><label for="state">Account state</label><select id="state" name="state"><option value="">All states</option><option>ACTIVE</option><option>PENDING</option><option>DISABLED</option><option>LOCKED</option></select></div><button class="btn btn-secondary" type="submit">Refresh</button><button class="btn btn-secondary" type="button" data-filter-clear="user-filters">Clear Filters</button></form>
<c:choose><c:when test="${empty accounts}"><section class="card"><div class="card-body"><h2 class="section-title">${filtersActive ? 'No matching accounts' : 'No accounts yet'}</h2><p>${filtersActive ? 'Keep or clear the active filters to broaden the result.' : 'Add the first account to begin.'}</p><c:choose><c:when test="${filtersActive}"><button class="btn btn-secondary" type="button" data-filter-clear="user-filters">Clear Filters</button></c:when><c:otherwise><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/users/new">Add Account</a></c:otherwise></c:choose></div></section></c:when><c:otherwise><div class="table-wrap"><table class="data-table" aria-label="User accounts"><thead><tr><th scope="col">Username</th><th scope="col">Email</th><th scope="col">Operational role</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody><c:forEach items="${accounts}" var="account"><tr><td>${account.username}</td><td>${account.email}</td><td>${rolesByAccount[account.userId]}</td><td><c:set var="statusKind" value="account"/><c:set var="statusValue" value="${account.status}"/><%@ include file="../../fragments/status-badge.jspf" %></td><td><a class="btn btn-link" href="${pageContext.request.contextPath}/admin/users/${account.userId}/edit">Edit</a><a class="btn btn-link" href="${pageContext.request.contextPath}/admin/users/${account.userId}/access">Access</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></main></div></div></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../../fragments/head.jspf" %></head><body><%@ include file="../../fragments/shell.jspf" %><h1 class="page-title">Role and access</h1><%@ include file="../../fragments/flash.jspf" %>
<section class="card"><div class="card-body"><h2 class="section-title">${account.username}</h2><p>${account.email}</p><p>Current role: <c:forEach items="${assignedRoles}" var="role">${role.roleName}</c:forEach></p><p>Member status: <c:set var="statusKind" value="account"/><c:set var="statusValue" value="${account.status}"/><%@ include file="../../fragments/status-badge.jspf" %></p>
<div class="command-bar"><c:choose><c:when test="${account.status eq 'PENDING'}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/users/${account.userId}/state?action=approve">Approve member</a></c:when><c:when test="${account.status eq 'ACTIVE'}"><a class="btn btn-danger" href="${pageContext.request.contextPath}/admin/users/${account.userId}/state?action=disable">Disable member</a></c:when><c:when test="${account.status eq 'DISABLED'}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/users/${account.userId}/state?action=enable">Enable member</a></c:when><c:when test="${account.status eq 'LOCKED'}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/users/${account.userId}/state?action=unlock">Unlock member</a></c:when></c:choose></div></div></section>
<form class="card form-grid" method="post" action="${pageContext.request.contextPath}/admin/users/${account.userId}/roles" data-submit-lock><%@ include file="../../fragments/csrf.jspf" %><div class="field"><label for="roleId">Operational role</label><select id="roleId" name="roleId"><option value="">Select exactly one role</option><c:forEach items="${roles}" var="role"><option value="${role.roleId}">${role.roleName}</option></c:forEach></select></div><div class="sticky-actions"><button class="btn btn-primary" type="submit">Save role</button><a class="btn btn-secondary" href="${pageContext.request.contextPath}/admin/users">Cancel</a></div></form></main></div></div></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">${notification.title}</h1><section class="card"><div class="card-body"><p>${notification.message}</p><dl><dt>Event</dt><dd>${notification.eventType}</dd><dt>Created</dt><dd>${notification.createdAt}</dd><dt>Delivery</dt><dd>${notification.deliveryStatus}</dd></dl><c:if test="${notification.prescriptionId gt 0}"><a class="btn btn-secondary" href="${pageContext.request.contextPath}/patient/prescriptions/${notification.prescriptionId}">View related prescription</a></c:if><c:if test="${notification.unread}"><form method="post" action="${pageContext.request.contextPath}/patient/notifications/${notification.notificationId}/read"><%@ include file="../fragments/csrf.jspf" %><button class="btn btn-primary" type="submit">Mark as read</button></form></c:if></div></section></main></div></div></body></html>

<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><%@ include file="../fragments/head.jspf" %></head><body><%@ include file="../fragments/shell.jspf" %><h1 class="page-title">Notifications</h1><%@ include file="../fragments/flash.jspf" %><c:choose><c:when test="${empty notifications}"><section class="card"><div class="card-body"><h2 class="section-title">You are all caught up</h2><p>Prescription and dispensing alerts will appear here.</p></div></section></c:when><c:otherwise><section class="card"><div class="card-section"><c:forEach items="${notifications}" var="notification"><article class="${notification.unread ? 'notification-unread' : 'notification-read'}"><div class="command-bar"><div><c:if test="${notification.unread}"><span aria-label="Unread">●</span></c:if><h2 class="section-title"><a href="${pageContext.request.contextPath}/patient/notifications/${notification.notificationId}">${notification.title}</a></h2><p>${notification.message}</p><span class="muted">${notification.createdAt}</span></div><c:if test="${notification.deliveryFailed}"><span class="status status-danger">Failed</span></c:if><c:if test="${notification.unread}"><form method="post" action="${pageContext.request.contextPath}/patient/notifications/${notification.notificationId}/read"><%@ include file="../fragments/csrf.jspf" %><button class="btn btn-secondary" type="submit">Mark read</button></form></c:if></div></article></c:forEach></div></section></c:otherwise></c:choose></main></div></div></body></html>
